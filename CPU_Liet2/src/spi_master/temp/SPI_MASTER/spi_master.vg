`pragma protect end_protected
module SPI_MASTER_Top (
  I_CLK,
  I_RESETN,
  I_TX_EN,
  I_WADDR,
  I_WDATA,
  I_RX_EN,
  I_RADDR,
  O_RDATA,
  O_SPI_INT,
  MISO_MASTER,
  MOSI_MASTER,
  SS_N_MASTER,
  SCLK_MASTER,
  MISO_SLAVE,
  MOSI_SLAVE,
  SS_N_SLAVE,
  SCLK_SLAVE
)
;
input I_CLK;
input I_RESETN;
input I_TX_EN;
input [2:0] I_WADDR;
input [31:0] I_WDATA;
input I_RX_EN;
input [2:0] I_RADDR;
output [31:0] O_RDATA;
output O_SPI_INT;
input MISO_MASTER;
output MOSI_MASTER;
output [0:0] SS_N_MASTER;
output SCLK_MASTER;
output MISO_SLAVE;
input MOSI_SLAVE;
input SS_N_SLAVE;
input SCLK_SLAVE;
wire VCC;
wire GND;
  \~spi_master.SPI_MASTER_Top  u_spi_master (
    .I_CLK(I_CLK),
    .I_RX_EN(I_RX_EN),
    .MISO_MASTER(MISO_MASTER),
    .I_TX_EN(I_TX_EN),
    .I_RESETN(I_RESETN),
    .I_WDATA(I_WDATA[31:0]),
    .I_RADDR(I_RADDR[2:0]),
    .I_WADDR(I_WADDR[2:0]),
    .MOSI_MASTER(MOSI_MASTER),
    .O_SPI_INT(O_SPI_INT),
    .SCLK_MASTER(SCLK_MASTER),
    .O_RDATA(O_RDATA[31:0]),
    .SS_N_MASTER(SS_N_MASTER[0])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
  GSR GSR (
    .GSRI(VCC) 
);
endmodule /* SPI_MASTER_Top */
